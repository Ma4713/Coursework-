extends layout

block content
  .profile-layout
    .profile-side.center
      .avatar-large= user[0].name.charAt(0)
      h1.profile-name= user[0].name
      p.card-subtitle= user[0].course
      p.meta Year: #{user[0].year_of_study}
      .role-badge= user[0].offers_help ? 'Mentor' : 'Learner'

    .profile-main
      h2.card-title User Profile

      .info-grid
        .info-box
          h3 Needs Help With
          .subject-tags
            each item in user
              if item.type === 'needs_help'
                span.subject-tag= item.subject_name
          if !user.some(item => item.type === 'needs_help')
            p.empty No subjects listed.

        .info-box
          h3 Confident In
          .subject-tags
            each item in user
              if item.type === 'confident_in'
                span.subject-tag= item.subject_name
          if !user.some(item => item.type === 'confident_in')
            p.empty No subjects listed.

        .info-box
          h3 Bio
          p= user[0].bio || 'No bio available.'

        .info-box
          h3 Availability
          p Mon–Fri
          p 14:30–18:00

      .actions-row
        a.button(href='/sessions') Request Study Buddy
        a.button-secondary(href='/users') Back to Users