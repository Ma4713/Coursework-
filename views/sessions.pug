extends layout

block content
  .page-hero
    h1 Study Sessions
    p Browse and join upcoming study sessions.

  .toolbar
    input.search-bar(type='text', placeholder='Search sessions...')
    .filters
      .filter-pill Subject
      .filter-pill Time
      .filter-pill Availability

  .session-grid
    each session in sessions
      .card
        h2.card-title= session.title
        .subject-tags
          span.subject-tag= session.subject_name
        p.meta Date / Time: #{session.session_time}
        p.meta Hosted by: #{session.mentor_name}
        .actions-row
          a.button-secondary(href=`/sessions/${session.id}`) View Details