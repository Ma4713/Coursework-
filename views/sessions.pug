extends layout

block content
  .hero
    h1 Study Sessions
    p Browse current sessions and open a session for more detail.

  .session-list
    each session in sessions
      .session-card
        h2= session.title
        p.meta Subject: #{session.subject_name}
        p.meta Mentor: #{session.mentor_name}
        p.meta Time: #{session.session_time}
        .actions
          a.button(href=`/sessions/${session.id}`) View Details