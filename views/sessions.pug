extends layout

block content
  .page-hero
    h1 Study Sessions
    p Browse and join upcoming study sessions.

  .toolbar
    form(method='GET', action='/sessions')
      input.search-bar(type='text', name='search', placeholder='Search by subject or title...', value=search)
      .actions-row
        button.button(type='submit') Search
        a.button-secondary(href='/sessions') Reset

  .session-grid
    each session in sessions
      .card
        h2.card-title= session.title
        .subject-tags
          span.subject-tag= session.subject_name
        p.meta Date / Time: #{session.session_time}
        p.meta Hosted by: #{session.mentor_name}
        .actions-row
          a.button-secondary(href=`/sessions/${session.id}`) View Details
          a.button(href=`/sessions/${session.id}/join`) Join Session