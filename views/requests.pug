extends layout

block content
  .page-hero
    h1 Study Requests
    p Messages from students who want to connect with you.

  .session-grid
    each request in requests
      .card
        h2.card-title= request.sender_name

        p= request.message

        p.meta
          strong Status:
          |  #{request.status}

        p.meta Sent: #{request.created_at}

        if request.status === 'pending'
          .actions-row
            form(method='POST', action=`/requests/${request.id}/accept`)
              button.button(type='submit') Accept

            form(method='POST', action=`/requests/${request.id}/decline`)
              button.button-danger(type='submit') Decline

        if request.status === 'accepted'
          p.success-message Request accepted.

        if request.status === 'declined'
          p.meta Request declined.

    if requests.length === 0
      .card
        p No requests yet.