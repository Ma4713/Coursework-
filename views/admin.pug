extends layout

block content
  .page-hero
    h1 System Admin Dashboard
    p Technical admin area for maintaining Study Buddy.

  .grid.grid-3
    .card.center
      h2.card-title Users
      p.meta Total Users
      h1= totalUsers
      a.button(href='/admin/users') Manage Users
    
    .card.center
      h2.card-title Feedback
      p.meta Session reviews
      a.button(href='/admin/feedback') View Feedback   

    .card.center
      h2.card-title Sessions
      p.meta Total Sessions
      h1= totalSessions
      a.button(href='/admin/sessions') Manage Sessions

    .card.center
      h2.card-title Subjects
      p.meta Total Subjects
      h1= totalSubjects

      a.button-secondary(href='/admin/requests') View Requests