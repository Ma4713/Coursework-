extends layout

block content
  .page-hero.center
    h1 User List
    p Browse through learners and mentors to connect with your study buddies.

  .user-grid
    each user in users
      .card.center
        .avatar-medium= user.name.charAt(0)
        h2.card-title= user.name
        p.meta Role: #{user.offers_help ? 'Mentor' : 'Learner'}
        p.meta #{user.course || 'Course not added'} · Year #{user.year_of_study || 'N/A'}
        .actions-row.center
          a.button-secondary(href=`/users/${user.id}`) View Profile