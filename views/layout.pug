doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title #{title} | Study Buddy
    link(rel='stylesheet', href='/styles.css')
  body
    header.site-header
      .site-header-inner
        a.brand(href='/')
          img.brand-logo(src='/images/studybuddy-logo.png', alt='Study Buddy logo')

        nav.nav
          a(class=activePage === 'home' ? 'active' : '', href='/') Home
          a(class=activePage === 'users' ? 'active' : '', href='/users') Users
          a(class=activePage === 'sessions' ? 'active' : '', href='/sessions') Sessions
      .header-line

    main.page
      block content