doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title #{title} | Study Buddy
    link(rel='stylesheet', href='/styles.css')

  body
    header.site-header
      .site-header-inner
        a.brand(href='/')
          img.brand-logo(src='/images/studybuddy-logo.png', alt='Study Buddy logo')

        nav.nav
          a(class=activePage === 'home' ? 'active' : '', href='/') Home

          if !session.user
            a(class=activePage === 'login' ? 'active' : '', href='/login') Login
            a(class=activePage === 'register' ? 'active' : '', href='/register') Register

          if session.user && session.user.role === 'student'
            span.user-welcome Welcome, #{session.user.name}

            a(class=activePage === 'dashboard' ? 'active' : '', href='/dashboard') Dashboard
            a(class=activePage === 'users' ? 'active' : '', href='/users') Users
            a(class=activePage === 'sessions' ? 'active' : '', href='/sessions') Sessions
            a(class=activePage === 'requests' ? 'active' : '', href='/requests') Requests
            a(href='/logout') Logout

          if session.user && session.user.role === 'admin'
            span.user-welcome Welcome, #{session.user.name}

            a(class=activePage === 'admin' ? 'active' : '', href='/admin') Admin Dashboard
            a(href='/logout') Logout

      .header-line

    main.page
      block content